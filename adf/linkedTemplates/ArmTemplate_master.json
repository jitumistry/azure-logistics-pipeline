{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "logistic-adf"
        },
        "AzureDataLake_accountKey": {
            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'AzureDataLake'"
        },
        "databricks_logostics_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'databricks_logostics'"
        },
        "AzureDataLake_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://logisticdatalakestorage.dfs.core.windows.net/"
        },
        "OpenWeather_Api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "http://api.openweathermap.org"
        },
        "myTomTom_Api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://api.tomtom.com"
        },
        "OpenMeteo_Api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://api.open-meteo.com"
        },
        "RestCountries_Api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://restcountries.com"
        },
        "Waqi_Api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://api.waqi.info/"
        },
        "databricks_logostics_properties_typeProperties_existingClusterId": {
            "type": "string",
            "defaultValue": "0530-012328-1m22ux0i"
        },
        "RestCountry_Trigger_properties_restCountry_ingestion_parameters_RestCountry_api": {
            "type": "string",
            "defaultValue": "?fields=name,capital,timezones,region,currencies"
        },
        "openWeatherMap_Trigger_properties_OpenWeatherMap_ingestion_parameters_OpenWeather_Api_Key": {
            "type": "string",
            "defaultValue": "a77407607388c1258e807910fc19780e"
        },
        "TomTom_Trigger_properties_TomTom_ingestion_parameters_TomTom_api": {
            "type": "string",
            "defaultValue": "K5LM2atJ1Mx6ujWDJkvKCBTl6MEdE6FV"
        },
        "openMeteo_Trigger_properties_openmeteo_ingestion_parameters_OpenMetro_api": {
            "type": "string",
            "defaultValue": "&hourly=temperature_2m,rain,snowfall,precipitation_probability,wind_speed_10m,visibility,weather_code"
        },
        "Wagi_Trigger_properties_Waqi_ingestion_parameters_waqi_api_key": {
            "type": "string",
            "defaultValue": "e548efc8f3854921d7edebe4e85b71216b3c2b81"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "logistic-adf_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "AzureDataLake_accountKey": {
                        "value": "[parameters('AzureDataLake_accountKey')]"
                    },
                    "databricks_logostics_accessToken": {
                        "value": "[parameters('databricks_logostics_accessToken')]"
                    },
                    "AzureDataLake_properties_typeProperties_url": {
                        "value": "[parameters('AzureDataLake_properties_typeProperties_url')]"
                    },
                    "OpenWeather_Api_properties_typeProperties_url": {
                        "value": "[parameters('OpenWeather_Api_properties_typeProperties_url')]"
                    },
                    "myTomTom_Api_properties_typeProperties_url": {
                        "value": "[parameters('myTomTom_Api_properties_typeProperties_url')]"
                    },
                    "OpenMeteo_Api_properties_typeProperties_url": {
                        "value": "[parameters('OpenMeteo_Api_properties_typeProperties_url')]"
                    },
                    "RestCountries_Api_properties_typeProperties_url": {
                        "value": "[parameters('RestCountries_Api_properties_typeProperties_url')]"
                    },
                    "Waqi_Api_properties_typeProperties_url": {
                        "value": "[parameters('Waqi_Api_properties_typeProperties_url')]"
                    },
                    "databricks_logostics_properties_typeProperties_existingClusterId": {
                        "value": "[parameters('databricks_logostics_properties_typeProperties_existingClusterId')]"
                    }
                }
            },
            "dependsOn": []
        },
        {
            "name": "logistic-adf_ArmTemplate_1",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "RestCountry_Trigger_properties_restCountry_ingestion_parameters_RestCountry_api": {
                        "value": "[parameters('RestCountry_Trigger_properties_restCountry_ingestion_parameters_RestCountry_api')]"
                    },
                    "openWeatherMap_Trigger_properties_OpenWeatherMap_ingestion_parameters_OpenWeather_Api_Key": {
                        "value": "[parameters('openWeatherMap_Trigger_properties_OpenWeatherMap_ingestion_parameters_OpenWeather_Api_Key')]"
                    },
                    "TomTom_Trigger_properties_TomTom_ingestion_parameters_TomTom_api": {
                        "value": "[parameters('TomTom_Trigger_properties_TomTom_ingestion_parameters_TomTom_api')]"
                    },
                    "openMeteo_Trigger_properties_openmeteo_ingestion_parameters_OpenMetro_api": {
                        "value": "[parameters('openMeteo_Trigger_properties_openmeteo_ingestion_parameters_OpenMetro_api')]"
                    },
                    "Wagi_Trigger_properties_Waqi_ingestion_parameters_waqi_api_key": {
                        "value": "[parameters('Wagi_Trigger_properties_Waqi_ingestion_parameters_waqi_api_key')]"
                    }
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'logistic-adf_ArmTemplate_0')]"
            ]
        }
    ]
}