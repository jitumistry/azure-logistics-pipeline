{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "logistic-adf"
        },
        "AzureDataLake_accountKey": {
            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'AzureDataLake'"
        },
        "databricks_logostics_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'databricks_logostics'"
        },
        "AzureDataLake_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://logisticdatalakestorage.dfs.core.windows.net/"
        },
        "OpenWeather_Api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "http://api.openweathermap.org"
        },
        "myTomTom_Api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://api.tomtom.com"
        },
        "OpenMeteo_Api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://api.open-meteo.com"
        },
        "RestCountries_Api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://restcountries.com"
        },
        "Waqi_Api_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://api.waqi.info/"
        },
        "databricks_logostics_properties_typeProperties_existingClusterId": {
            "type": "string",
            "defaultValue": "0530-012328-1m22ux0i"
        }
    },
